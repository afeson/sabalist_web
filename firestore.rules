rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Listings collection
    // IMPORTANT CONSTRAINT: native iOS/Android use @react-native-firebase/auth
    // for auth but the Firebase JS SDK for Firestore (separate app instance), so
    // request.auth is ALWAYS null on native writes — a logged-in native user is
    // indistinguishable from an anonymous caller at this layer. We therefore
    // cannot require auth for writes without breaking the shipped apps (fixing
    // that needs an app-side auth change, deliberately out of scope). Instead we
    // harden the anonymous branch as much as possible without breaking native.
    match /listings/{listingId} {
      allow read: if true;

      // Authenticated (web) OR a well-formed anonymous write (native). Requiring
      // an owner id + a title stops the anonymous branch from injecting blank or
      // garbage documents. Native createListing always sends userId + title.
      allow create: if request.auth != null
                    || (request.resource.data.userId is string
                        && request.resource.data.userId.size() > 0
                        && request.resource.data.title is string
                        && request.resource.data.title.size() > 0);

      // Authenticated OR anonymous ONLY IF ownership is preserved. Native edit /
      // mark-sold / reactivate / view-counting never change userId, so they pass;
      // this blocks an anonymous caller from hijacking a listing to a new owner
      // or blindly rewriting a doc whose owner id it doesn't already preserve.
      allow update: if request.auth != null
                    || request.resource.data.userId == resource.data.userId;

      // Authenticated OR the native (unauthenticated) delete path. NOTE: native
      // hard-deletes over an unauthenticated SDK and carries no request body, so
      // a native delete is indistinguishable from an anonymous one and CANNOT be
      // locked here without breaking the apps. Compensating controls (owner's
      // choice): scheduled Firestore backups + bulk-delete alerting. Do NOT
      // change this to request.auth-only — it will break native delete.
      allow delete: if request.auth != null
                    || (resource.data.userId is string
                        && resource.data.userId.size() > 0);
    }

    // Users collection - Allow users to read/write their own data
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Favorites subcollection - users can manage their own favorites
      match /favorites/{favoriteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Settings subcollection - users can manage their own settings (location, preferences)
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // --- Ingestion / admin collections -------------------------------------
    // The ingestion pipeline writes via the firebase-admin SDK (bypasses rules).
    // These rules only govern the admin DASHBOARD's reads + review actions.
    // Keep this allowlist in sync with admin/config.js (adminEmails).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['afesonabebe@yahoo.com'];
    }

    // Review queue — dashboard reads pending items and approves/rejects them.
    match /listings_staging/{id} {
      allow read, update: if isAdmin();
      allow create, delete: if false; // created by the admin-SDK pipeline only
    }

    // Per-run stats + failures — dashboard reads; writes are admin-SDK only.
    match /ingestion_stats/{id} { allow read: if isAdmin(); allow write: if false; }
    match /import_failures/{id} { allow read: if isAdmin(); allow write: if false; }

    // Source configs (when moved into Firestore for UI CRUD).
    match /ingestion_sources/{id} { allow read, write: if isAdmin(); }

    // Backend-driven marketplace config — public read (logged-out web + first
    // app launch need it); only the admin dashboard may write (the seeder uses
    // the admin SDK, which bypasses rules).
    match /marketplace_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Business claims — a business owner submits a pending claim from the
    // public /claim page (server route writes via the client SDK, unauthenticated).
    // Only the admin dashboard reads/decides. Creates must be well-formed and land
    // as 'pending' so a claim can never self-approve.
    match /business_claims/{id} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && (request.resource.data.businessId is string
                        || request.resource.data.sellerName is string);
      allow read, update, delete: if isAdmin();
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
